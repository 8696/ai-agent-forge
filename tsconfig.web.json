{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./web/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["web/**/*", "shared/**/*", "tests/**/*.test.tsx"]
}
