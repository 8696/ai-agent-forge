{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./web/*"],
      "@shared/*": ["./shared/*"],
      "@ai-sdk-internal": ["./node_modules/@ai-sdk/react/node_modules/ai"]
    }
  },
  "include": ["web/**/*", "shared/**/*"]
}
