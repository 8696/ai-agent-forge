# ─── 操作系统 ──────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── 编辑器 / IDE ──────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.fuse_hidden*
.history/

# ─── Node.js ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged

# ─── TypeScript ────────────────────────────
*.tsbuildinfo
dist/
build/
*.tsbuildinfo

# ─── Vite / React 前端 ────────────────────
.vite/
.cache/
coverage/
*.local

# ─── 环境变量 / 密钥 ───────────────────────
.env
.env.*
!.env.example
.envrc

# ─── 日志 ──────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── 临时文件 ──────────────────────────────
tmp/
temp/
.tmp/
.cache/

# ─── 测试覆盖率 ────────────────────────────
.nyc_output/
coverage/
*.lcov

# ─── 文档项目特有 ──────────────────────────
# 文档项目不需要 node_modules 和构建产物,
# 但保留 .DS_Store 在根目录被忽略即可

# ─── 数据 / 上传文件（不入库） ─────────────
data/
data/qdrant-snapshot/

# ─── Claude Desktop 本地配置（不入库） ──────────────────
.claude/
# 桌面 app Remote Control 写入的临时文件（不同次会话后缀会变）
.uuremote_*

# ─── 测试基建产物 ───────────────────────────────────
# E2E 登录拿到的 JWT / API key 落盘（docs/12-d §D6 测试基建契约）
.e2e-tokens.json
# Playwright 的运行产物（trace / 截图 / html 报告）
test-results/
playwright-report/
blob-report/
.playwright/
