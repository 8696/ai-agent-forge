{
  "name": "agent-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AgentForge - 多租户的 AI 文档问答平台",
  "type": "module",
  "engines": {
    "node": ">=22.4.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:backend": "yarn migrate && tsx watch src/server.ts",
    "dev:backend:test": "NODE_ENV=test PORT=3099 yarn migrate && NODE_ENV=test PORT=3099 tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "yarn build:backend && yarn build:frontend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:undo": "tsx scripts/migrate.ts --undo",
    "seed": "tsx tests/fixtures/seed.ts",
    "e2e:login": "node tests/helpers/login-all.mjs",
    "test:fixtures": "yarn seed && yarn e2e:login",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "vitest run --config vitest.config.ts tests/e2e",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"web/**/*.{ts,tsx,json,md}\" \"shared/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"web/**/*.{ts,tsx,json,md}\" \"shared/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/react": "^4.0.143",
    "@ant-design/icons": "^6.3.4",
    "@anthropic-ai/sdk": "^0.134.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "ai": "^7.0.140",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-body": "^8.0.1",
    "koa-bodyparser": "^4.4.1",
    "lru-cache": "^11.5.3",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "nodejieba": "^3.5.8",
    "pdf-parse": "2.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^15.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "resolutions": {
    "@types/koa": "2.15.2"
  }
}
