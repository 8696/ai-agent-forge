{
  "name": "agent-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AgentForge - 多租户的 AI 文档问答平台",
  "type": "module",
  "engines": {
    "node": ">=22.4.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:backend": "yarn migrate && tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "yarn build:backend && yarn build:frontend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:undo": "tsx scripts/migrate.ts --undo",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"web/**/*.{ts,tsx,json,md}\" \"shared/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"web/**/*.{ts,tsx,json,md}\" \"shared/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/react": "^4.0.141",
    "@ant-design/icons": "^6.3.4",
    "@anthropic-ai/sdk": "^0.32.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "ai": "^4.0.0",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-body": "^8.0.1",
    "koa-bodyparser": "^4.4.1",
    "lru-cache": "^11.0.2",
    "mysql2": "^3.11.5",
    "nanoid": "^5.0.9",
    "pdf-parse": "1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.4",
    "vitest": "^2.1.8"
  },
  "resolutions": {
    "@types/koa": "2.15.2"
  }
}
