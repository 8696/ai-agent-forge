# ═══════════════════════════════════════════════════════════════════
# AgentForge · 本地开发环境变量模板（提交此文件，复制成 .env 再填）
# 真实凭据只放 .env（已 gitignore），提交时永远不要把这些值写进 .env.example
#
# 约定：.env 和 .env.example 结构完全一致（同一组 key，同一顺序，同一注释）。
# 值的差异规则：
#   - *_API_KEY / *_PASSWORD / *_SECRET：.env 写真值，.env.example 留空
#   - 其他配置：本文件是本地默认（localhost / OpenAI 默认等）；
#     dev 用远程基础设施时，.env 里的非 secret 值可以不同
#     （比如 MYSQL_HOST=47.94.160.155 / QDRANT_URL=远程地址 / 切换 LLM provider）
# 改完两边记得用 scripts/sync-env.ts 同步一次
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ─── 数据库 ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform

# ─── 向量库（Step 4+ 用）──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── 知识库 / 文档上传（Step 4 用）──────────────────────────────────
# 本地数据根目录（上传文件落 ./data/uploads/{tenant_id}/）
DATA_DIR=./data
# 单文件上限（50 MB）
MAX_UPLOAD_BYTES=52428800
# 拆块参数（与 docs/05-b §5.6 / docs/15 §Step 4 一致；改完 Qdrant 要重建索引）
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── 选用（换线路只改这里）────────────────────────────────────────
# LLM_PROVIDER  minimax | zhipu | deepseek | qwen | custom
# LLM_MODEL     留空 = 用该提供商默认模型；填写则 Anthropic 协议 LLM 走这个 id
# LLM_EMBEDDING_MODEL  留空 = 用该提供商默认嵌入模型；没嵌入接口的 provider 这一行留空
LLM_PROVIDER=minimax
LLM_MODEL=
LLM_EMBEDDING_MODEL=

# ── MiniMax（LLM_PROVIDER=minimax）────────────────────────────────
# 控制台：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3
MINIMAX_EMBEDDING_MODEL=embo-01

# ── 智谱（LLM_PROVIDER=zhipu）─────────────────────────────────────
# 控制台：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.3
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_ANTHROPIC_MODEL=glm-5.3
ZHIPU_EMBEDDING_MODEL=embedding-3

# ── DeepSeek（LLM_PROVIDER=deepseek）──────────────────────────────
# 控制台：https://platform.deepseek.com/api_keys
# 官方：https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANTHROPIC_MODEL=deepseek-v4-pro
DEEPSEEK_EMBEDDING_MODEL=

# ── 千问（LLM_PROVIDER=qwen）──────────────────────────────────────
# 控制台：https://bailian.console.aliyun.com/?tab=model#/api-key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
QWEN_ANTHROPIC_MODEL=qwen3.8-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ── 自定义网关（LLM_PROVIDER=custom）──────────────────────────────
# Anthropic 协议 / OpenAI 兼容协议都支持
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_MODEL=
CUSTOM_EMBEDDING_MODEL=

# ─── 对话（B1 · 多轮对话 + LLM 流式）──────────────────────────────────
# ⚠️ **下面这 6 项默认在租户后台「租户设置」里配**（docs/12-c §C4）：
#      CHAT_RETRIEVAL_TOP_K        检索召回条数
#      CHAT_MAX_HISTORY_TURNS     最多记多少轮历史
#      CHAT_RETRIEVAL_TOKEN_BUDGET 检索片段 token 上限
#      CHAT_CONTEXT_TOKEN_BUDGET   单轮上下文总预算（成本闸门）
#      CHAT_MAX_INPUT_CHARS        单条消息字数上限
#      CHAT_THINKING_BUDGET_TOKENS 思考模式预算（0 = 关）
#    平台级默认值写在 src/config.ts 里；想批量改全平台默认值时，
#    把对应键加回本文件即可（租户没覆盖的项会走这里的值）。
#
# 留在平台级、不给租户开的（安全 / 传输 / 内部估算边界）：
# 本地 token 估算刻意高估，留这个比例给估算误差
CHAT_BUDGET_SAFETY_RATIO=0.15
# 系统提示词 token 上限（默认提示词约 330 token，超了会硬截断）
CHAT_SYSTEM_TOKEN_BUDGET=600
# 单次回复最大输出 token / 生成温度（模型条目里没填时才用这里的值）
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_TEMPERATURE=0.2
# SSE 心跳间隔（ms），<=0 关闭；部署在 nginx 后面建议保持 >0，否则长检索可能被掐断
CHAT_KEEPALIVE_MS=15000

# ─── 租户级配置（C3 提示词 / C4 模型选择）───────────────────────────
# 租户在后台自定义 LLM apiKey 时的**落库加密密钥**（AES-256-GCM）。
# 留空 = 禁止保存 apiKey（不是降级成明文存）。
# ⚠️ 生产必须配；配了之后**永远别换** —— 换了对不上的旧密文解不出来。
CONFIG_ENCRYPTION_KEY=
# 是否允许租户把 LLM base_url 指向内网地址（防 SSRF，见 src/lib/llm-endpoint.ts）。
# dev 默认放开；生产默认拦截。要指自建的局域网网关时显式设 true
CONFIG_ALLOW_PRIVATE_LLM_ENDPOINT=false

# ─── 安全防护（D4 · docs/12-d-需求-运维稳定.md §D4）──────────────────
# 敏感数据脱敏：身份证 / 银行卡 / 手机号 → ***（写进 messages 之前就换掉）。
# 建议一直开着，关掉等于把明文号码存进对话历史
SECURITY_PII_MASK_ENABLED=true
# 敏感词库审核（暴力 / 色情 / 政治 / 歧视）
SECURITY_SENSITIVE_WORDS_ENABLED=true
# 提示词注入检测（规则层）
SECURITY_INJECTION_ENABLED=true
# 注入检测的大模型二次确认策略：
#   confirm = 只在规则命中时问模型（默认，省钱）
#   always  = 每条输入都问模型（最严，也最贵）
#   off     = 不问模型，只用规则（规则命中就拦）
SECURITY_INJECTION_LLM_MODE=confirm
# 输出审核的大模型复核。默认关 —— 一次回答要额外一次 LLM 调用，
# 而且 SSE 已经把字节发出去了，复核只能事后纠正、不能真正「不返回给用户」。
# 词库那层（SECURITY_SENSITIVE_WORDS_ENABLED）是常开的
SECURITY_OUTPUT_LLM_CHECK=false
# 审核类 LLM 调用的超时（ms）—— 超了按「判不出来」处理，不拖住用户请求
SECURITY_GUARD_TIMEOUT_MS=8000

# ─── 限流（D5 · docs/12-d-需求-运维稳定.md §D5）──────────────────────
# 进程内 Map 限流（单实例有效；多实例时每个实例各限各的）
RATE_LIMIT_ENABLED=true
# 限流窗口长度（ms）
RATE_LIMIT_WINDOW_MS=60000
# 单租户窗口内最大请求数（0 = 不限）。租户可在后台「租户设置」里覆盖
RATE_LIMIT_MAX_REQUESTS=100
# 单用户窗口内最大请求数（0 = 不限）
RATE_LIMIT_MAX_REQUESTS_PER_USER=30

# ─── 成本控制（D3 · docs/12-d-需求-运维稳定.md §D3）──────────────────
# 每次 LLM 调用后写 cost_logs 表（token 明细 + 估算花费）
COST_TRACKING_ENABLED=true
# 超过租户月度 token 阈值时是否**直接拒绝**新请求。
# 默认只告警不拦截 —— 拦掉意味着租户的用户直接用不了 AI，
# 那是运营决策（该在后台看到告警后自己降配额），不该由平台默认替租户做
COST_BUDGET_BLOCK=false
# 自定义价格表（JSON，美元 / 100 万 token）。
# 不填 = 用 src/lib/cost-pricing.ts 里的内置估算表（精度只够看量级）
# 例：{"glm-5.3": {"input": 0.6, "output": 2.2}}
COST_PRICE_TABLE=

# ─── 观测（D2）──────────────────────────────────────────────────────
# 采集 trace / span（后台「观测」页的数据源）。关掉后业务链路不受影响
TRACE_ENABLED=true
# 同时往 logs/trace-YYYY-MM-DD.jsonl 写一份副本（docs/09-观测方案.md §9.1）
TRACE_FILE_ENABLED=true

# ─── 评测（D1）──────────────────────────────────────────────────────
EVALUATION_ENABLED=true
# 单个评测集最多多少条题（一条题 = 2 次 LLM 调用：生成 + 裁判），成本闸门
EVALUATION_MAX_ITEMS=50

# ─── JWT ───────────────────────────────────────────────────────────
# 生产替换；dev 用 32+ 字符的占位串就行
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=info
