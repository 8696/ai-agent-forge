# ═══════════════════════════════════════════════════════════════════
# AgentForge · 本地开发环境变量模板（提交此文件，复制成 .env 再填）
# 真实凭据只放 .env（已 gitignore），提交时永远不要把这些值写进 .env.example
#
# 约定：.env 和 .env.example 结构完全一致（同一组 key，同一顺序，同一注释）。
# 值的差异规则：
#   - *_API_KEY / *_PASSWORD / *_SECRET：.env 写真值，.env.example 留空
#   - 其他配置：本文件是本地默认（localhost / OpenAI 默认等）；
#     dev 用远程基础设施时，.env 里的非 secret 值可以不同
#     （比如 MYSQL_HOST=47.94.160.155 / QDRANT_URL=远程地址 / 切换 LLM provider）
# 改完两边记得用 scripts/sync-env.ts 同步一次
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ─── 数据库 ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform

# ─── 向量库（Step 4+ 用）──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── 知识库 / 文档上传（Step 4 用）──────────────────────────────────
# 本地数据根目录（上传文件落 ./data/uploads/{tenant_id}/）
DATA_DIR=./data
# 单文件上限（50 MB）
MAX_UPLOAD_BYTES=52428800
# 拆块参数（与 docs/05-b §5.6 / docs/15 §Step 4 一致；改完 Qdrant 要重建索引）
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── 选用（换线路只改这里）────────────────────────────────────────
# LLM_PROVIDER  minimax | zhipu | deepseek | qwen | custom
# LLM_MODEL     留空 = 用该提供商默认模型；填写则 Anthropic 协议 LLM 走这个 id
# LLM_EMBEDDING_MODEL  留空 = 用该提供商默认嵌入模型；没嵌入接口的 provider 这一行留空
LLM_PROVIDER=minimax
LLM_MODEL=
LLM_EMBEDDING_MODEL=

# ── MiniMax（LLM_PROVIDER=minimax）────────────────────────────────
# 控制台：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3
MINIMAX_EMBEDDING_MODEL=embo-01

# ── 智谱（LLM_PROVIDER=zhipu）─────────────────────────────────────
# 控制台：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.3
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_ANTHROPIC_MODEL=glm-5.3
ZHIPU_EMBEDDING_MODEL=embedding-3

# ── DeepSeek（LLM_PROVIDER=deepseek）──────────────────────────────
# 控制台：https://platform.deepseek.com/api_keys
# 官方：https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANTHROPIC_MODEL=deepseek-v4-pro
DEEPSEEK_EMBEDDING_MODEL=

# ── 千问（LLM_PROVIDER=qwen）──────────────────────────────────────
# 控制台：https://bailian.console.aliyun.com/?tab=model#/api-key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
QWEN_ANTHROPIC_MODEL=qwen3.8-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ── 自定义网关（LLM_PROVIDER=custom）──────────────────────────────
# Anthropic 协议 / OpenAI 兼容协议都支持
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_MODEL=
CUSTOM_EMBEDDING_MODEL=

# ─── JWT ───────────────────────────────────────────────────────────
# 生产替换；dev 用 32+ 字符的占位串就行
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=info
