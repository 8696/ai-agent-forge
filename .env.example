# ═══════════════════════════════════════════════════════════════════
# AgentForge · 本地开发环境变量模板（提交此文件，复制成 .env 再填）
# 真实凭据只放 .env（已 gitignore），提交时永远不要把这些值写进 .env.example
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ─── 数据库 ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform

# ─── 向量库（Step 4+ 用）──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── LLM 提供商开关（主用 = 切这里；备选自动按 provider 走不同 _ANTHROPIC_* 凭据）──
# 取值：minimax | zhipu | deepseek | qwen | custom
LLM_PROVIDER=minimax
# 留空 = 用提供商的默认 model id（见下方 *_ANTHROPIC_MODEL）；填值则强制覆盖
LLM_MODEL=

# ── MiniMax ────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3

# ── 智谱 ───────────────────────────────────────────────────────────
ZHIPU_API_KEY=
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_ANTHROPIC_MODEL=glm-4.5

# ── DeepSeek ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANTHROPIC_MODEL=deepseek-v3

# ── 千问 ───────────────────────────────────────────────────────────
QWEN_API_KEY=
QWEN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
QWEN_ANTHROPIC_MODEL=qwen3-max

# ── 自定义网关（Anthropic 协议）─────────────────────────────────────
CUSTOM_API_KEY=
CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_MODEL=

# ─── JWT ───────────────────────────────────────────────────────────
# 生产替换；dev 用 32+ 字符的占位串就行
JWT_SECRET=replace-me-with-a-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ─── Embedding（独立 REST 客户端，不走 Vercel AI SDK）──────────────────
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ─── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=info
