# ─── 运行时 ────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── 数据库 ────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform

# ─── 向量库 ────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── LLM（Anthropic 协议）────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ─── JWT ───────────────────────────────────
JWT_SECRET=please-replace-with-a-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ─── Embedding ─────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ─── 日志 ───────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
