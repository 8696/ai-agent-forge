# ══════════════════════════════════════════════════════════════════
# AgentForge · 环境变量模板（复制成 .env 再填；真值只放 .env，别提交）
#
# .env 与 .env.example 结构完全一致（同一组 key / 同一顺序 / 同一注释），只有值不同：
#   *_API_KEY / *_PASSWORD / *_SECRET → .env 写真值，.env.example 留空
#   其他                          → .env.example 是本地默认；
#                                  .env 可 dev override（远程 MySQL / 换 provider）
#
# 哪些 key 该存在：看 src/config.ts 的 envSchema —— 有的就得在两个文件里都有，
# 没有的两个都别留（死 key）。例外只有 7 个，见 scripts/env-contract.ts。
#
# 改完跑：yarn env:sync（同步）/ yarn env:check（只校验，漂了退出码 1）
# 守卫测试：tests/unit/env-consistency.test.ts
# ══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ─── 数据库 ───────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform

# ─── 向量库 ───────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── 知识库 / 文档上传 ────────────────────────────────────────────
# 上传文件落 ./data/uploads/{tenant_id}/
DATA_DIR=./data
# 单文件上限（50 MB）
MAX_UPLOAD_BYTES=52428800
# 拆块参数（docs/05-b §5.6）；改完要重建 Qdrant 索引
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ─── 选用（换线路只改这里） ───────────────────────────────────────
# LLM_PROVIDER  minimax | zhipu | deepseek | qwen | custom
# LLM_MODEL / LLM_EMBEDDING_MODEL  留空 = 用该 provider 的默认模型
LLM_PROVIDER=minimax
LLM_MODEL=
LLM_EMBEDDING_MODEL=

# ─── MiniMax（LLM_PROVIDER=minimax） ──────────────────────────────
# 控制台：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3
MINIMAX_EMBEDDING_MODEL=embo-01

# ─── 智谱（LLM_PROVIDER=zhipu） ───────────────────────────────────
# 控制台：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.3
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_ANTHROPIC_MODEL=glm-5.3
ZHIPU_EMBEDDING_MODEL=embedding-3

# ─── DeepSeek（LLM_PROVIDER=deepseek） ────────────────────────────
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANTHROPIC_MODEL=deepseek-v4-pro
DEEPSEEK_EMBEDDING_MODEL=

# ─── 千问（LLM_PROVIDER=qwen） ────────────────────────────────────
# 控制台：https://bailian.console.aliyun.com/?tab=model#/api-key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
QWEN_ANTHROPIC_MODEL=qwen3.8-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ─── 自定义网关（LLM_PROVIDER=custom） ────────────────────────────
# Anthropic 协议 / OpenAI 兼容协议都支持
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_MODEL=
CUSTOM_EMBEDDING_MODEL=

# ─── 对话（B1 · 多轮对话 + LLM 流式） ─────────────────────────────
# 下面这 6 项默认在租户后台「租户设置」里配（docs/12-c §C4），本文件不写：
#   CHAT_RETRIEVAL_TOP_K / CHAT_MAX_HISTORY_TURNS / CHAT_RETRIEVAL_TOKEN_BUDGET
#   CHAT_CONTEXT_TOKEN_BUDGET / CHAT_MAX_INPUT_CHARS / CHAT_THINKING_BUDGET_TOKENS
# 平台级默认值在 src/config.ts；想批量改全平台默认值就把对应键加回本文件。
#
# 下面这 5 项留在平台级，不给租户开：
# token 估算的安全垫比例（估算刻意高估）
CHAT_BUDGET_SAFETY_RATIO=0.15
# 系统提示词 token 上限（默认提示词约 330 token）
CHAT_SYSTEM_TOKEN_BUDGET=600
# 单次回复最大输出 token（模型条目里没填时才用这个）
CHAT_MAX_OUTPUT_TOKENS=2048
# 生成温度（模型条目里没填时才用这个）
CHAT_TEMPERATURE=0.2
# SSE 心跳间隔（ms），<=0 关闭；nginx 后面建议 >0，否则长检索可能被掐断
CHAT_KEEPALIVE_MS=15000

# ─── 会话摘要压缩（B1 · docs/12-b §B1.1） ─────────────────────────
# 长对话超出上下文预算时，把更早的对话折成摘要写进 sessions.summary，下一轮再注入。
# ⚠️ 摘要 = 额外一次 LLM 调用（长对话每轮最多一次）。租户可在「租户设置 → 记忆」关掉，
#    或配一条 usage_scope='summary' 的便宜模型压成本。
# 租户可配：summary_enabled（开关）/ summary_token_budget（整段上限，含约 190 token 固定说明）
CHAT_SUMMARY_ENABLED=true
# 摘要段 token 上限（固定说明 + 摘要正文）
CHAT_SUMMARY_TOKEN_BUDGET=600
# 摘要正文目标字数（写进提示词约束长度）
CHAT_SUMMARY_TARGET_CHARS=300
# 一次摘要的输入上限（token），超了分批消化
CHAT_SUMMARY_MAX_INPUT_TOKENS=4000
# 摘要超时（ms），超了就放弃这次压缩，不拖住用户请求
CHAT_SUMMARY_TIMEOUT_MS=15000

# ─── 重排序（B2 · docs/07-c 模块 09） ─────────────────────────────
# 用重排模型把 RRF 融合出的候选再排一遍（RRF 只看排名，重排看内容）。
# 协议是 Cohere 兼容的 POST {地址}，body {model, query, documents, top_n}，
# 响应 {results:[{index, relevance_score}]} —— 自建 bge-reranker / 硅基流动 / Jina / Cohere 都吃这个格式。
# ⚠️ RERANK_API_URL 留空 = 不做重排（走纯 RRF）；调不通自动降级回 RRF，不影响检索。
# 租户可在「租户设置 → 知识库」单独关掉自己的重排（rerank_enabled）。
RERANK_ENABLED=true
# 重排服务地址（完整 URL）。第三方示例：https://api.siliconflow.cn/v1/rerank
RERANK_API_URL=
# 重排服务的 API key（自建一般留空）
RERANK_API_KEY=
# 重排模型 id（自建一般填 bge-reranker-v2-m3；第三方按各家文档填）
RERANK_MODEL=bge-reranker-v2-m3
# 单次重排超时（ms），超了降级回 RRF
RERANK_TIMEOUT_MS=8000
# 送多少个候选去重排（RRF 融合后、截断 topK 前）
RERANK_CANDIDATES=20

# ─── 租户级配置（C3 提示词 / C4 模型选择） ────────────────────────
# 租户自定义 LLM apiKey 的落库加密密钥（AES-256-GCM）。
# 留空 = 禁止保存 apiKey（不降级成明文）。生产必须配，且配了之后永远别换 ——
# 换了对不上的旧密文解不开。
CONFIG_ENCRYPTION_KEY=
# 是否允许租户把 LLM base_url 指向内网地址（防 SSRF，见 src/lib/llm-endpoint.ts）。
# 生产默认拦截；dev 要指自建的局域网网关时设 true
CONFIG_ALLOW_PRIVATE_LLM_ENDPOINT=false

# ─── 租户隔离（A1 · docs/12-a §A1） ───────────────────────────────
# 运行时强制：请求级租户上下文 + Sequelize 全局钩子自动补 tenant_id 过滤。
# ⚠️ 平台级硬边界，不给租户开关。上线后出问题可先关掉止血（退回「靠人记得加过滤」），修好再开。
TENANT_SCOPE_ENFORCE=true

# ─── 安全防护（D4 · docs/12-d §D4） ───────────────────────────────
# 敏感数据脱敏（身份证 / 银行卡 / 手机号 → ***）没有开关了 —— 写进历史库前的最后一道防线
# 敏感词库审核（暴力 / 色情 / 政治 / 歧视）
SECURITY_SENSITIVE_WORDS_ENABLED=true
# 提示词注入检测（规则层）
SECURITY_INJECTION_ENABLED=true
# 注入检测的大模型二次确认：confirm = 只在规则命中时问模型（默认）/ always = 每条都问（最贵）/
#   off = 不问模型，只用规则
SECURITY_INJECTION_LLM_MODE=confirm
# 输出审核的大模型复核。默认关 —— 额外一次 LLM 调用，且 SSE 已把字节发出去，只能事后纠正
SECURITY_OUTPUT_LLM_CHECK=false
# 审核类 LLM 调用超时（ms），超了按「判不出来」处理
SECURITY_GUARD_TIMEOUT_MS=8000

# ─── 限流（D5 · docs/12-d §D5） ───────────────────────────────────
# 进程内 Map 限流（单实例有效；多实例时每个实例各限各的）
RATE_LIMIT_ENABLED=true
# 限流窗口长度（ms）
RATE_LIMIT_WINDOW_MS=60000
# 单租户窗口内最大请求数（0 = 不限），租户可在后台覆盖
RATE_LIMIT_MAX_REQUESTS=100
# 单用户窗口内最大请求数（0 = 不限）
RATE_LIMIT_MAX_REQUESTS_PER_USER=30

# ─── 熔断（D5 · docs/12-d §D5） ───────────────────────────────────
# 上游连着挂时别再往里冲：连续失败到阈值就断开，期间快速失败。
# 进程内状态，多实例各断各的；按端点分桶，某租户自己的端点挂了只断它自己。
CIRCUIT_BREAKER_ENABLED=true
# 连续失败多少次就断开
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# 断开后多久放一个请求探活（ms）
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ─── 成本控制（D3 · docs/12-d §D3） ───────────────────────────────
# 每次 LLM 调用后写 cost_logs 表（token 明细 + 估算花费）
COST_TRACKING_ENABLED=true
# 超过租户月度 token 阈值时是否直接拒绝新请求。默认只告警不拦截 ——
# 拦掉意味着租户的用户用不了 AI，该由运营在后台降配额
COST_BUDGET_BLOCK=false
# 自定义价格表（JSON，美元 / 100 万 token）。不填 = 用 src/lib/cost-pricing.ts 的内置估算表
# 例：{"glm-5.3": {"input": 0.6, "output": 2.2}}
COST_PRICE_TABLE=

# ─── 观测（D2） ───────────────────────────────────────────────────
# 采集 trace / span（后台「观测」页的数据源），关掉不影响业务链路
TRACE_ENABLED=true
# 同时往 logs/trace-YYYY-MM-DD.jsonl 写一份副本（docs/09 §9.1）
TRACE_FILE_ENABLED=true

# ─── 评测（D1） ───────────────────────────────────────────────────
EVALUATION_ENABLED=true
# 单个评测集最多多少题（一题 = 2 次 LLM 调用：生成 + 裁判），成本闸门
EVALUATION_MAX_ITEMS=50

# ─── 用户长期记忆（B4 · docs/12-b §B4） ───────────────────────────
# 平台级总开关，关掉 = 既不抽取也不注入
# （租户级在「租户设置 → 记忆」，用户级在用户自己的「我的记忆」页）
MEMORY_ENABLED=true
# 单个用户最多保留多少条生效中的记忆，超出的从最不重要的开始归档
MEMORY_MAX_ACTIVE_PER_USER=50
# 自动抽取的最低置信度，低于就不入库（用户自己写的不受此限制）
MEMORY_MIN_CONFIDENCE=0.5
# 记忆抽取的 LLM 调用超时（ms）。别设太小：推理型模型光是「想」就要 10 秒以上，
# 8 秒会把每次抽取都掐掉。抽取是 fire-and-forget，调大不影响用户体感
MEMORY_EXTRACT_TIMEOUT_MS=30000
# 记忆按相关性排序的平台总开关。关掉 = 退回固定顺序（用户写 > 管理员写 > 自动抽）
# ⚠️ 租户级还有同名开关（memory_relevance_enabled），两层都开才生效
MEMORY_RELEVANCE_ENABLED=true
# 算问题向量的超时（ms），超了退回固定顺序
MEMORY_RELEVANCE_TIMEOUT_MS=3000
#
# ⚠️ 记忆抽取 = 额外一次 LLM 调用（每轮最多一次），实测约 2000 token（思考 token 占大头）。
#
# 租户在「租户设置 → 记忆」里配：memory_enabled（总开关）/ memory_top_k（每轮注入几条）/
#   memory_token_budget（记忆段 token 上限）/ memory_relevance_enabled（相关性排序）

# ─── JWT ──────────────────────────────────────────────────────────
# 生产必须换；dev 用 32+ 字符的占位串就行
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── 日志 ─────────────────────────────────────────────────────────
LOG_LEVEL=info
